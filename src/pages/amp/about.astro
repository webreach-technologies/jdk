---
import AmpLayout from '../../layouts/AmpLayout.astro';
import AmpPageHero from '../../components/amp/AmpPageHero.astro';
import AmpImage from '../../components/amp/AmpImage.astro';
import AmpBusesTypes from '../../components/amp/AmpBusesTypes.astro';
import AmpAmenities from '../../components/amp/AmpAmenities.astro';
import AmpCompanies from '../../components/amp/AmpCompanies.astro';
import AmpServicesTypes from '../../components/amp/AmpServicesTypes.astro';
import AmpServiceAreas from '../../components/amp/AmpServiceAreas.astro';
import AmpCalltoBook from '../../components/amp/AmpCalltoBook.astro';
import FAQ from '../../components/FAQ.astro';
import AboutHero from "../../assets/banners/cta.jpg";
import StoryImage from "../../assets/banners/ourstory.jpg";

const siteUrl = "https://jdktransportation.com";

const aboutFaqs = [
  {
    question: "How long has JDK Transportation been in business?",
    answer: "JDK Transportation has been providing motor coach rentals for over 15 years, growing from a small fleet into a trusted regional transportation provider for schools, corporations, sports teams, and groups of every size."
  },
  {
    question: "What types of groups do you work with?",
    answer: "We work with schools, corporations, wedding parties, sports teams, religious organizations, travel agents, government agencies, and any group that needs safe, reliable group transportation."
  },
  {
    question: "What makes JDK Transportation different?",
    answer: "We combine a diverse, well-maintained fleet with licensed professional drivers and 24/7 dispatch support. Every trip is backed by a team committed to safety, comfort, and on-time performance."
  },
  {
    question: "Where does JDK Transportation operate?",
    answer: "We serve the Northeast Corridor (Newark, Jersey City, New York, Philadelphia), Ontario (Toronto, Niagara Falls), and South and Central Florida (Miami, Fort Lauderdale, Orlando), with service to surrounding towns and regions."
  },
  {
    question: "How do I contact JDK Transportation?",
    answer: "Call our 24/7 team at 877-377-7172 or submit a quote request online. We typically respond with pricing details within 30 minutes."
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
        { "@type": "ListItem", "position": 2, "name": "About Us", "item": siteUrl + "/about/" }
      ]
    },
    {
      "@type": "AboutPage",
      "name": "About JDK Transportation",
      "url": siteUrl + "/about/",
      "description": "Learn about JDK Transportation's story, mission, and commitment to safe, reliable motor coach rentals for groups of all sizes.",
      "mainEntity": {
        "@type": "Organization",
        "name": "JDK Transportation",
        "url": siteUrl,
        "telephone": "+1-877-377-7172",
        "email": "info@jdktransportation.com"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": aboutFaqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    }
  ]
};
---

<AmpLayout
  title="About Us | JDK Transportation - Motor Coach Rental Company"
  description="Learn about JDK Transportation, a trusted motor coach rental company providing safe, comfortable, and reliable group transportation for corporate travel, school trips, weddings, and special events.">

  <AmpPageHero
    image={AboutHero}
    imageAlt="About JDK Transportation - Motor Coach Rental Company"
    breadcrumb={[{ label: "Home", href: "/amp/" }, { label: "About Us" }]}
    title="About JDK Transportation"
    subtitle="Safe, comfortable, and reliable motor coach rentals for groups of every size."
    headingId="about-hero-heading"
    showCta={false}
  />

  <!-- Our Story -->
  <section aria-labelledby="our-story-heading" class="bg-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-10 items-start">

      <div>
        <h2 id="our-story-heading" class="text-center md:text-start text-4xl md:text-5xl font-phudu font-extrabold uppercase tracking-wide">
          Our <span class="text-primary">Story</span>
        </h2>

        <p class="mt-5 text-base md:text-lg font-medium leading-snug">
          JDK Transportation &ndash; Moving Together, Sharing Experiences.
        </p>

        <p class="mt-4 text-base md:text-lg font-light leading-snug">
          We&rsquo;re not just in the business of moving people, we&rsquo;re in the business of moving
          experiences. As a premier bus charter service specializing in institutional transport,
          employee shuttles, airport transfers, and group travel across the East Coast, we ensure
          that every journey is seamless, reliable, and built on trust.
        </p>

        <h3 class="mt-6 text-xl md:text-2xl font-phudu font-extrabold uppercase tracking-wide">
          Our Promise: Precision, Comfort, and Reliability
        </h3>

        <p class="mt-3 text-base md:text-lg font-light leading-snug">
          JDK Transportation was founded on the belief that movement should be more than just
          getting from point A to point B&mdash;it should be an extension of efficiency,
          professionalism, and hospitality. Whether transporting students, corporate teams, or
          event-goers, our modern fleet and expert drivers deliver a superior travel experience
          tailored to every client&rsquo;s needs.
        </p>

        <p class="mt-4 text-base md:text-lg font-light leading-snug">
          We understand that transportation isn&rsquo;t just logistics&mdash;it&rsquo;s a service
          that brings people together. That&rsquo;s why institutions trust us with their daily
          routes, organizations rely on us for group transport, and travelers choose us for their
          airport and cruise transfers or any event transfer. Our dedicated partnerships with
          schools, businesses, and tour operators ensure that we&rsquo;re not just another bus
          company, we&rsquo;re a partner in their travel.
        </p>

        <h3 class="mt-6 text-xl md:text-2xl font-phudu font-extrabold uppercase tracking-wide">
          Why Choose JDK Transportation?
        </h3>

        <ul class="mt-3 space-y-2 text-base md:text-lg font-light leading-snug list-disc pl-5">
          <li><span class="font-medium">Tailored Solutions:</span> Customized routes and schedules built for efficiency.</li>
          <li><span class="font-medium">Comfort &amp; Safety:</span> A well-maintained fleet with professional, safety-certified drivers.</li>
          <li><span class="font-medium">Punctuality You Can Count On:</span> Whether for daily commutes or special events, we run on reliability.</li>
        </ul>

        <p class="mt-4 text-base md:text-lg font-light leading-snug">
          At JDK Transportation, every mile is a promise&mdash;a promise of trust, excellence, and
          the confidence that when you ride with us, you&rsquo;re not just traveling. You&rsquo;re
          arriving.
        </p>

        <p class="mt-4 text-base md:text-lg font-light leading-snug">
          As custodians of mobility, we create safe, dependable, and seamless transportation
          experiences that connect communities, strengthen relationships, and move people forward
          with confidence.
        </p>
      </div>

      <div class="overflow-hidden rounded-2xl shadow-md">
        <AmpImage
          src={StoryImage}
          alt="Comfortable interior seating inside a JDK Transportation motor coach" />
      </div>

    </div>
  </section>

  <!-- Mission & Values -->
  <section aria-labelledby="mission-heading" class="bg-gray-100 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-10">
        <h2 id="mission-heading" class="text-4xl md:text-5xl font-phudu font-extrabold uppercase tracking-wide">
          Our Mission & <span class="text-primary">Values</span>
        </h2>
        <p class="mt-4 text-sm md:text-base font-light max-w-2xl mx-auto">
          Everything we do is guided by a commitment to safety, comfort, and dependable service.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">

        <div class="bg-white rounded-xl shadow-lg p-6 flex items-start gap-4 border border-gray-400">
          <div class="text-black shrink-0" aria-hidden="true">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 11l3 3 5-5" />
              <path d="M19.778 15.222 23 12l-3.222-3.222V4.222h-4.556L12 1 8.778 4.222H4.222v4.556L1 12l3.222 3.222v4.556h4.556L12 23l3.222-3.222h4.556v-4.556z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium mb-1">Safety First</h3>
            <p class="text-sm font-light leading-snug">
              Every vehicle in our fleet is regularly inspected and maintained, and every driver is
              licensed, trained, and committed to getting your group there safely.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-6 flex items-start gap-4 border border-gray-400">
          <div class="text-black shrink-0" aria-hidden="true">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 11l3 3 5-5" />
              <path d="M19.778 15.222 23 12l-3.222-3.222V4.222h-4.556L12 1 8.778 4.222H4.222v4.556L1 12l3.222 3.222v4.556h4.556L12 23l3.222-3.222h4.556v-4.556z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium mb-1">Comfort & Reliability</h3>
            <p class="text-sm font-light leading-snug">
              From climate control to onboard amenities, our coaches are built for long trips and
              short hops alike &mdash; and we pride ourselves on showing up on time, every time.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-6 flex items-start gap-4 border border-gray-400">
          <div class="text-black shrink-0" aria-hidden="true">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 11l3 3 5-5" />
              <path d="M19.778 15.222 23 12l-3.222-3.222V4.222h-4.556L12 1 8.778 4.222H4.222v4.556L1 12l3.222 3.222v4.556h4.556L12 23l3.222-3.222h4.556v-4.556z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium mb-1">Customer-Focused Service</h3>
            <p class="text-sm font-light leading-snug">
              Our 24/7 team works with you to plan the right vehicle, route, and schedule, so your
              group can focus on the trip &mdash; not the logistics.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section aria-labelledby="why-choose-heading" class="relative w-full py-12 text-white">
    <div class="absolute inset-0 bg-black"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="why-choose-heading" class="text-center text-4xl md:text-5xl font-phudu font-extrabold uppercase tracking-wide">
        Why Groups Choose <span class="text-primary">JDK Transportation</span>
      </h2>

      <dl class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <dt class="text-3xl md:text-4xl font-phudu font-extrabold text-primary">15+</dt>
          <dd class="mt-2 text-sm md:text-base font-light">Years of Experience</dd>
        </div>
        <div>
          <dt class="text-3xl md:text-4xl font-phudu font-extrabold text-primary">15-56</dt>
          <dd class="mt-2 text-sm md:text-base font-light">Passenger Vehicle Sizes</dd>
        </div>
        <div>
          <dt class="text-3xl md:text-4xl font-phudu font-extrabold text-primary">100+</dt>
          <dd class="mt-2 text-sm md:text-base font-light">Metro Areas Served</dd>
        </div>
        <div>
          <dt class="text-3xl md:text-4xl font-phudu font-extrabold text-primary">24/7</dt>
          <dd class="mt-2 text-sm md:text-base font-light">Dispatch & Support</dd>
        </div>
      </dl>
    </div>
  </section>

  <AmpBusesTypes />
  <AmpAmenities />
  <AmpCompanies />
  <AmpServicesTypes />
  <AmpServiceAreas />

  <FAQ
    title="About Us"
    subheading="Common questions about JDK Transportation and how we work."
    items={aboutFaqs}
    headingId="about-faq-heading"
  />

  <AmpCalltoBook />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

</AmpLayout>
