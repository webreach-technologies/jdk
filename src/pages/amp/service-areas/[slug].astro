---
import { getCollection, render } from 'astro:content';
import AmpLayout from '../../../layouts/AmpLayout.astro';
import AmpPageHero from '../../../components/amp/AmpPageHero.astro';
import AmpImage from '../../../components/amp/AmpImage.astro';
import AmpCalltoBook from '../../../components/amp/AmpCalltoBook.astro';
import FAQ from '../../../components/FAQ.astro';
import { withBase } from '../../../utils/url';
import AreaHero from "../../../assets/banners/cta.jpg";

export async function getStaticPaths() {
  const areas = await getCollection('serviceAreas');
  return areas.map((area) => ({
    params: { slug: area.id },
    props: { area },
  }));
}

const { area } = Astro.props;
const { name, state, summary, heroImage, highlights, idealFor, nearbyAreas, faqs, seo } = area.data;
const { Content } = await render(area);

const siteUrl = "https://jdktransportation.com";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
        { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": siteUrl + "/service-areas/" },
        { "@type": "ListItem", "position": 3, "name": `${name}, ${state}`, "item": siteUrl + "/service-areas/" + area.id + "/" }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Motor Coach Rental",
      "name": `Motor Coach Rentals in ${name}, ${state}`,
      "description": summary,
      "provider": {
        "@type": "Organization",
        "name": "JDK Transportation",
        "url": siteUrl,
        "telephone": "+1-877-377-7172",
        "email": "info@jdktransportation.com"
      },
      "areaServed": { "@type": "City", "name": `${name}, ${state}` },
      "url": siteUrl + "/service-areas/" + area.id + "/"
    },
    ...(faqs && faqs.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    }] : [])
  ]
};
---

<AmpLayout title={seo.title} description={seo.description}>

  <AmpPageHero
    image={AreaHero}
    imageAlt={`Motor coach rental services in ${name}, ${state}`}
    breadcrumb={[{ label: "Home", href: "/amp/" }, { label: "Service Areas", href: "/amp/service-areas/" }, { label: `${name}, ${state}` }]}
    title={`${name}, ${state}`}
    subtitle={summary}
    headingId="area-hero-heading"
  />

  <!-- Area Details -->
  <section aria-labelledby="area-overview-heading" class="bg-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-3 gap-10 items-start">

      <!-- Main Content -->
      <div class="lg:col-span-2">

        <p class="text-sm font-medium uppercase tracking-wide text-primary">{state}</p>
        <h2 id="area-overview-heading" class="mt-2 text-4xl md:text-5xl font-phudu font-extrabold uppercase tracking-wide">
          Service <span class="text-primary">Overview</span>
        </h2>

        <div class="mt-5 text-base md:text-lg font-light leading-snug [&_h2]:font-phudu [&_h2]:font-extrabold [&_h2]:uppercase [&_h2]:tracking-wide [&_h2]:text-2xl [&_h2]:md:text-3xl [&_h2]:mt-6 [&_h2]:mb-2">
          <Content />
        </div>

        <!-- Popular Destinations -->
        <div class="mt-12 pt-10 border-t border-gray-200">
          <h2 class="text-3xl md:text-4xl font-phudu font-extrabold uppercase tracking-wide mb-6">
            Popular <span class="text-primary">Destinations</span>
          </h2>

          <div class="grid sm:grid-cols-2 gap-6">
            {highlights.map((highlight) => (
              <div class="bg-gray-100 rounded-2xl overflow-hidden">
                <div class="overflow-hidden">
                  <AmpImage src={highlight.image ?? heroImage} alt={highlight.label} />
                </div>
                <div class="p-5">
                  <h3 class="font-medium text-lg">{highlight.label}</h3>
                  <p class="mt-1 text-sm font-light leading-snug">{highlight.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="rounded-2xl border border-gray-200 shadow-md overflow-hidden">

          <div class="overflow-hidden">
            <AmpImage src={heroImage} alt={`Motor Coach serving ${name}, ${state}`} />
          </div>

          <div class="p-6">
            <h3 class="text-xl font-phudu font-extrabold uppercase tracking-wide">{name}, {state}</h3>

            <div class="mt-5 flex flex-col gap-3">
              <button on="tap:quoteLightbox.open" class="flex items-center justify-center gap-2 bg-primary text-black font-normal px-6 py-3 text-sm rounded-full transition-all duration-300 hover:scale-105 cursor-pointer">
                Get a Quote in 30 Minutes
              </button>
              <a href="tel:+18773777172" class="flex items-center justify-center gap-2 bg-black text-white font-normal px-6 py-3 text-sm rounded-full transition-all duration-300 hover:scale-105">
                Call: 877-377-7172
              </a>
            </div>

            <!-- Ideal For -->
            <div class="mt-6 pt-6 border-t border-gray-200">
              <h4 class="text-sm font-semibold uppercase tracking-wide mb-3">
                Ideal <span class="text-primary">For</span>
              </h4>
              <ul class="space-y-2">
                {idealFor.map((item) => (
                  <li class="flex items-start gap-2 text-sm font-light leading-snug">
                    <svg class="w-4 h-4 mt-0.5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Nearby Areas -->
            {nearbyAreas.length > 0 && (
              <div class="mt-6 pt-6 border-t border-gray-200">
                <h4 class="text-sm font-semibold uppercase tracking-wide mb-3">
                  Nearby <span class="text-primary">Areas</span>
                </h4>
                <div class="flex flex-wrap gap-2">
                  {nearbyAreas.map((nearby) => (
                    <a
                      href={withBase(`/amp/service-areas/${nearby.slug}/`)}
                      class="inline-flex items-center gap-2 bg-gray-100 rounded-full px-4 py-1.5 text-xs font-medium transition-all duration-300 hover:bg-primary hover:text-black"
                    >
                      {nearby.name}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>

        </div>
      </aside>

    </div>
  </section>

  {faqs && faqs.length > 0 && (
    <FAQ
      title={`${name}, ${state}`}
      titleHighlight="FAQs"
      subheading={`Common questions about motor coach rentals in ${name}, ${state}.`}
      items={faqs}
      headingId="area-faq-heading"
    />
  )}

  <AmpCalltoBook />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

</AmpLayout>
