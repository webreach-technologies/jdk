---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import FAQ from '../../components/FAQ.astro';
import CalltoBook from '../../components/CalltoBook.astro';
import QuoteModalForm from '../../components/QuoteModalForm.astro';
import BlogHero from "../../assets/banners/cta.jpg";
import Logo from '../../assets/logo/logo.png';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, excerpt, heroImage, author, publishDate, category, faqs, seo } = post.data;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const breadcrumbWordLimit = 5;
const titleWords = title.split(' ');
const breadcrumbTitle = titleWords.length > breadcrumbWordLimit
  ? `${titleWords.slice(0, breadcrumbWordLimit).join(' ')}…`
  : title;

const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const aMatch = a.data.category === category ? 0 : 1;
    const bMatch = b.data.category === category ? 0 : 1;
    if (aMatch !== bMatch) return aMatch - bMatch;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  })
  .slice(0, 4);

const siteUrl = "https://jdktransportation.com";

const postImage = await getImage({ src: heroImage, width: 1200, format: 'jpg' });
const postImageUrl = `${siteUrl}${postImage.src}`;

const logoImage = await getImage({ src: Logo, format: 'png' });
const logoUrl = `${siteUrl}${logoImage.src}`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl + "/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": siteUrl + "/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": siteUrl + "/blog/" + post.id + "/"
        }
      ]
    },
    {
      "@type": "BlogPosting",
      "headline": title,
      "description": excerpt,
      "image": postImageUrl,
      "datePublished": publishDate.toISOString(),
      "author": {
        "@type": "Organization",
        "name": author,
      },
      "publisher": {
        "@type": "Organization",
        "name": "JDK Transportation",
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": logoUrl,
        },
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": siteUrl + "/blog/" + post.id + "/"
      },
      "url": siteUrl + "/blog/" + post.id + "/"
    },
    ...(faqs && faqs.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }] : [])
  ]
};
---

<Layout title={seo.title} description={seo.description} ampHref={`/amp/blog/${post.id}/`}>

  <!-- Post Hero -->
  <section aria-labelledby="post-hero-heading" class="relative w-full py-28 md:py-40 text-center text-white">

    <!-- Background Image -->
    <div class="absolute inset-0">
      <Image src={BlogHero} alt={`${title} - JDK Transportation`} quality={40} loading="eager" fetchpriority="high" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-4 text-sm font-light">
        <ol class="flex items-center justify-center gap-2">
          <li><a href={withBase('/')} class="hover:text-primary transition duration-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={withBase('/blog')} class="hover:text-primary transition duration-300">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-primary" title={title}>{breadcrumbTitle}</li>
        </ol>
      </nav>

      <h1 id="post-hero-heading" class="text-4xl md:text-6xl font-phudu font-extrabold uppercase tracking-wide">
        {title}
      </h1>

      <div class="mt-4 flex items-center justify-center text-sm font-light">
        <time datetime={publishDate.toISOString()}>{dateFormatter.format(publishDate)}</time>
      </div>

    </div>
  </section>

  <!-- Post Content -->
  <section aria-labelledby="post-content-heading" class="bg-white py-16 md:py-20">
    <div class={relatedPosts.length > 0
      ? "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-3 gap-10 items-start"
      : "max-w-3xl mx-auto px-4 sm:px-6 lg:px-8"}>

      <div class={relatedPosts.length > 0 ? "lg:col-span-2 min-w-0" : ""}>

        <h2 id="post-content-heading" class="sr-only">{title}</h2>

        <div class="overflow-hidden rounded-2xl shadow-md mb-10">
          <Image
            src={heroImage}
            alt={title}
            quality={40}
            loading="eager"
            class="w-full h-auto object-cover" />
        </div>

        <div class="prose prose-neutral max-w-none text-base md:text-lg font-light leading-snug [&_h2]:font-phudu [&_h2]:font-extrabold [&_h2]:uppercase [&_h2]:tracking-wide [&_h2]:text-2xl [&_h2]:md:text-3xl [&_h2]:mt-8 [&_h2]:mb-2 [&_ul]:list-disc [&_ul]:pl-5">
          <Content />
        </div>

      </div>

      {relatedPosts.length > 0 && (
        <aside aria-labelledby="related-posts-heading" class="lg:sticky lg:top-24">
          <h2 id="related-posts-heading" class="text-2xl font-phudu font-extrabold uppercase tracking-wide mb-6">
            Related <span class="text-primary">Posts</span>
          </h2>

          <div class="space-y-5">
            {relatedPosts.map((related) => (
              <div class="bg-gray-100 rounded-xl border border-gray-200 p-4">
                <h3 class="text-sm font-medium leading-snug line-clamp-2">{related.data.title}</h3>
                <time datetime={related.data.publishDate.toISOString()} class="block mt-1 text-xs font-light text-black/60">
                  {dateFormatter.format(related.data.publishDate)}
                </time>
                <a href={withBase(`/blog/${related.id}`)} class="inline-flex items-center gap-1 mt-2 text-xs font-semibold text-primary">
                  Read More <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            ))}
          </div>
        </aside>
      )}

    </div>
  </section>

  <!-- FAQ -->
  {faqs && faqs.length > 0 && (
    <FAQ
      title="Frequently Asked"
      titleHighlight="Questions"
      subheading={`Common questions related to ${title.toLowerCase()}.`}
      items={faqs}
      headingId="post-faq-heading"
    />
  )}

  <!-- Call to Action -->
  <CalltoBook />

  <QuoteModalForm />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

</Layout>
