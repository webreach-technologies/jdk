                        <a href={withBase('/amp/service-areas/philadelphia/')} class="block text-black hover:text-primary transition duration-300">Philadelphia</a>
                        <a href={withBase('/amp/service-areas/toronto/')} class="block text-black hover:text-primary transition duration-300">Toronto</a>
                        <a href={withBase('/amp/service-areas/niagara-falls-ny/')} class="block text-black hover:text-primary transition duration-300">Niagara Falls (NY)</a>
                        <a href={withBase('/amp/service-areas/niagara-falls-on/')} class="block text-black hover:text-primary transition duration-300">Niagara Falls (ON)</a>
                        <a href={withBase('/amp/service-areas/miami/')} class="block text-black hover:text-primary transition duration-300">Miami</a>
                        <a href={withBase('/amp/service-areas/fort-lauderdale/')} class="block text-black hover:text-primary transition duration-300">Fort Lauderdale</a>
                        <a href={withBase('/amp/service-areas/orlando/')} class="block text-black hover:text-primary transition duration-300">Orlando</a>
                        <a href={withBase('/amp/service-areas/')} class="group/link block col-span-2 mt-2 pt-2 border-t border-gray-200 font-semibold text-primary">View All Locations <span class="inline-block transition-transform duration-300 group-hover/link:translate-x-1">&rarr;</span></a>
