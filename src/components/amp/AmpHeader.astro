        <!-- Desktop CTAs -->
        <div class="hidden xl:flex items-center gap-3 shrink-0">
            <button on="tap:quoteLightbox.open" class="flex items-center gap-1 shrink-0 bg-black text-primary px-4 py-1.5 text-xs rounded-full border border-primary hover:scale-105 transition duration-300 cursor-pointer">
