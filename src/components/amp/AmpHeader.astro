                                    <li><a href={withBase('/amp/fleet/30-passenger-mini-coach/')} class="block text-black hover:text-primary transition duration-300">30 Passenger Mini Coach</a></li>
                                    <li><a href={withBase('/amp/fleet/33-passenger-mini-coach/')} class="block text-black hover:text-primary transition duration-300">33 Passenger Mini Coach</a></li>
                                    <li><a href={withBase('/amp/fleet/35-passenger-mini-coach/')} class="block text-black hover:text-primary transition duration-300">35 Passenger Mini Coach</a></li>
                                    <li><a href={withBase('/amp/fleet/40-passenger-mini-coach/')} class="block text-black hover:text-primary transition duration-300">40 Passenger Mini Coach</a></li>
                                </ul>
                            </div>
                        </div>
                        <a href={withBase('/amp/fleet/')} class="group/link block mt-3 pt-2 border-t border-gray-200 text-sm font-semibold text-primary">View All Buses <span class="inline-block transition-transform duration-300 group-hover/link:translate-x-1">&rarr;</span></a>
                    </div>
                </div>
            </li>

            <!-- Services Mega Menu -->
            <li class="dropdown-item group relative">
                <span class={`dropdown-trigger flex items-center gap-1 px-3 2xl:px-4 py-3.5 hover:text-primary transition duration-300 cursor-pointer ${isActiveSection('/services') ? 'text-primary' : ''}`}>
                    Services
                    <svg class="dropdown-icon w-3 h-3 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </span>
                <div class="dropdown-panel absolute left-0 top-full opacity-0 invisible -translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300">
                    <div class="bg-white text-black border-t-2 border-primary shadow-xl p-6 w-150 grid grid-cols-2 gap-x-8 gap-y-1.5 text-sm">
                        <a href={withBase('/amp/services/airport-shuttles/')} class="block text-black hover:text-primary transition duration-300">Airport Shuttles</a>
                        <a href={withBase('/amp/services/construction-site-shuttles/')} class="block text-black hover:text-primary transition duration-300">Construction Site Shuttles</a>
                        <a href={withBase('/amp/services/corporate-events/')} class="block text-black hover:text-primary transition duration-300">Corporate Events</a>
