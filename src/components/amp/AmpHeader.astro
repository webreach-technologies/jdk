---
import AmpImage from './AmpImage.astro';
import Logo from '../../assets/logo/logo.png';
import { withBase, stripBase } from '../../utils/url';

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const pathname = normalize(stripBase(Astro.url.pathname.replace(/^\/amp/, '')));
const isActive = (path: string) => pathname === normalize(path);
const isActiveSection = (prefix: string) => pathname === prefix || pathname.startsWith(`${prefix}/`);
---

<!-- Top Bar -->
<div class="bg-black text-white font-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 md:py-1.5">

        <!-- Marquee -->
        <div class="flex-1 min-w-0 overflow-hidden">
            <span class="marquee-track inline-block whitespace-nowrap text-xs font-medium text-primary">VIP TRANS, LLC is GSA for ECR BUSLINE, PATINO TOURS, JDK Transportation</span>
        </div>

    </div>
</div>

<!-- Logo + Navigation -->
<header class="bg-gray-100 font-light shadow-md sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 xl:py-0 min-h-20 flex items-center justify-between gap-4">

        <!-- Logo -->
        <div class="shrink-0 w-30 xl:w-32">
            <a href={withBase('/amp/')} class="block">
                <AmpImage src={Logo} alt="JDK Transportation Logo" />
            </a>
        </div>

        <!-- Desktop Nav -->
        <ul class="hidden xl:flex items-center text-sm font-normal">
            <li><a href={withBase('/amp/about/')} class={`block px-3 2xl:px-4 py-3.5 hover:text-primary transition duration-300 ${isActive('/about') ? 'text-primary' : ''}`}>About Us</a></li>

            <!-- Our Fleet Mega Menu -->
            <li class="dropdown-item group relative">
                <span class={`dropdown-trigger flex items-center gap-1 px-3 2xl:px-4 py-3.5 hover:text-primary transition duration-300 cursor-pointer ${isActiveSection('/fleet') ? 'text-primary' : ''}`}>
                    Our Fleet
                    <svg class="dropdown-icon w-3 h-3 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </span>
                <div class="dropdown-panel absolute left-0 top-full opacity-0 invisible -translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300">
                    <div class="bg-white text-black border-t-2 border-primary shadow-xl p-6 w-130">
                        <div class="grid grid-cols-2 gap-x-8 gap-y-1">
                            <div>
                                <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Motor Coaches</h4>
                                <ul class="space-y-1.5 text-sm">
                                    <li><a href={withBase('/amp/fleet/50-passenger-motor-coach/')} class="block text-black hover:text-primary transition duration-300">50 Passenger Motor Coach</a></li>
                                    <li><a href={withBase('/amp/fleet/54-passenger-motor-coach/')} class="block text-black hover:text-primary transition duration-300">54 Passenger Motor Coach</a></li>
                                    <li><a href={withBase('/amp/fleet/55-passenger-motor-coach/')} class="block text-black hover:text-primary transition duration-300">55 Passenger Motor Coach</a></li>
                                    <li><a href={withBase('/amp/fleet/56-passenger-motor-coach/')} class="block text-black hover:text-primary transition duration-300">56 Passenger Motor Coach</a></li>
                                </ul>
                                <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2 mt-4">Specialty Vehicles</h4>
                                <ul class="space-y-1.5 text-sm">
                                    <li><a href={withBase('/amp/fleet/sprinter-van/')} class="block text-black hover:text-primary transition duration-300">Sprinter Van</a></li>
                                    <li><a href={withBase('/amp/fleet/party-bus/')} class="block text-black hover:text-primary transition duration-300">Party Bus</a></li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Mini Buses</h4>
                                <ul class="space-y-1.5 text-sm">
                                    <li><a href={withBase('/amp/fleet/15-passenger-minibus/')} class="block text-black hover:text-primary transition duration-300">15 Passenger Minibus</a></li>
                                    <li><a href={withBase('/amp/fleet/18-passenger-minibus/')} class="block text-black hover:text-primary transition duration-300">18 Passenger Minibus</a></li>
                                    <li><a href={withBase('/amp/fleet/20-passenger-minibus/')} class="block text-black hover:text-primary transition duration-300">20 Passenger Minibus</a></li>
                                    <li><a href={withBase('/amp/fleet/25-passenger-minibus/')} class="block text-black hover:text-primary transition duration-300">25 Passenger Minibus</a></li>
                                    <li><a href={withBase('/amp/fleet/28-passenger-minibus/')} class="block text-black hover:text-primary transition duration-300">28 Passenger Minibus</a></li>
                                </ul>
                                <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2 mt-4">Mini Coaches</h4>
