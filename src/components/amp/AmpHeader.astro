                        <a href={withBase('/amp/services/')} class="group/link block col-span-2 mt-2 pt-2 border-t border-gray-200 font-semibold text-primary">View All Services <span class="inline-block transition-transform duration-300 group-hover/link:translate-x-1">&rarr;</span></a>
                    </div>
                </div>
            </li>

            <!-- Service Areas Mega Menu -->
            <li class="dropdown-item group relative">
